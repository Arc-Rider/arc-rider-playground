{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "server.ts",
    "data-server.ts",
    "main.ts",
    "contract.ts",
    "fixtures.ts"
  ]
}
